# Copy to .env on the server and fill in real values. Never commit .env.

STATS_DB_USER=stats
STATS_DB_PASSWORD=changeme
STATS_DB_NAME=stats

# Must match the three values above:
# postgresql://<STATS_DB_USER>:<STATS_DB_PASSWORD>@stats-db:5432/<STATS_DB_NAME>
DATABASE_URL=postgresql://stats:changeme@stats-db:5432/stats

# Used only to seed the first owner account on first run (if a user with
# this username doesn't already exist in the DB). Further accounts
# (collaborators, more owners) are managed from /admin/users.
ADMIN_USERNAME=choncotm
# bcrypt hash of the admin password, e.g. generated with:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash

# random secret used to sign admin session cookies, e.g.:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_random_hex_string

# Optional: powers the real Amazon Price Tracker bot dashboard
# (/admin/bots/amazon-price-tracker). Requires the amazon-price-tracker-bot
# project's stats-api service to be deployed and both containers joined to
# the shared external "bot-stats-net" Docker network (see that project's
# README). BOT_STATS_TOKEN must match the same var in its .env.
BOT_STATS_API_URL=http://bot-stats-api:8000
BOT_STATS_TOKEN=replace_with_a_random_shared_secret
